
config jiotv_go 'main'
	option enabled '1'
	# /usr/bin = flash (survives reboot); /tmp = RAM (re-downloaded from url at boot)
	option bin '/usr/bin/jiotv_go'
	option url ''
	option host '0.0.0.0'
	option port '5001'
	# login + settings; keep on flash so the Jio login survives reboots
	option path_prefix '/etc/jiotv_go'
	# request log goes to RAM; it logs every request and would wear/fill flash
	option log_path '/tmp/log/jiotv_go'
	option title 'JioTV Go'
	# TV guide, rebuilt daily; stored in epg_path (RAM) to spare flash. Empty epg_path = keep it in path_prefix
	option epg '0'
	option epg_path '/tmp/jiotv_go-epg'
	option drm '1'
	option disable_logout '1'
	option debug '0'
	# soft Go heap cap; EPG builds otherwise balloon to 200+ MB on small routers
	option memory_limit '128MiB'
