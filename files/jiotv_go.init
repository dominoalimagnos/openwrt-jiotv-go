#!/bin/sh /etc/rc.common
# JioTV Go service for OpenWrt (procd). Settings live in /etc/config/jiotv_go.

START=99
STOP=10
USE_PROCD=1

start_service() {
	config_load jiotv_go

	local enabled bin url host port path_prefix log_path title epg drm disable_logout debug
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get bin main bin /usr/bin/jiotv_go
	config_get url main url ''
	config_get host main host '0.0.0.0'
	config_get port main port 5001
	config_get path_prefix main path_prefix /etc/jiotv_go
	config_get log_path main log_path /tmp/log/jiotv_go
	config_get title main title 'JioTV Go'
	config_get_bool epg main epg 0
	config_get_bool drm main drm 1
	config_get_bool disable_logout main disable_logout 1
	config_get_bool debug main debug 0

	mkdir -p "$path_prefix" "$log_path"

	procd_open_instance
	# run.sh re-downloads the binary first when it lives in RAM (/tmp) and was lost on reboot
	procd_set_param command /usr/libexec/jiotv_go/run.sh "$bin" "$url" serve --host "$host" --port "$port"
	procd_set_param env \
		HOME="$path_prefix" \
		JIOTV_PATH_PREFIX="$path_prefix" \
		JIOTV_TITLE="$title" \
		JIOTV_EPG="$([ "$epg" -eq 1 ] && echo true || echo false)" \
		JIOTV_DRM="$([ "$drm" -eq 1 ] && echo true || echo false)" \
		JIOTV_DISABLE_LOGOUT="$([ "$disable_logout" -eq 1 ] && echo true || echo false)" \
		JIOTV_DEBUG="$([ "$debug" -eq 1 ] && echo true || echo false)" \
		JIOTV_LOG_PATH="$log_path"
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger jiotv_go
}
